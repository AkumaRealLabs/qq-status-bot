QQBOT_APP_ID=
QQBOT_APP_SECRET=

# 留空表示允许机器人所在的全部群；多个群 OpenID 用逗号分隔。
QQBOT_ALLOWED_GROUPS=
STATUS_COMMANDS=状态,status

STATUS_URL=https://status.ggapi.cc
STATUS_PAGE_ID=default
STATUS_PERIOD=1y
SCREENSHOT_TIMEOUT=90s
SCREENSHOT_QUEUE_SIZE=3

# GGAPI 账号绑定与余额查询（启用后必须同时配置 HTTPS 管理接口和 SMTP）
GGAPI_BALANCE_ENABLED=false
GGAPI_BASE_URL=https://www.ggapi.cc
GGAPI_ADMIN_TOKEN=
GGAPI_SMTP_HOST=
GGAPI_SMTP_PORT=587
GGAPI_SMTP_USERNAME=
GGAPI_SMTP_PASSWORD=
GGAPI_SMTP_FROM=
GGAPI_SMTP_FROM_NAME=GGAPI
GGAPI_SMTP_TLS_MODE=starttls
